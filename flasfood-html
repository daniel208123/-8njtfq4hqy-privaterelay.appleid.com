<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="FlashFOOD - Velocidad que se saborea.">
<title>FlashFOOD | Plataforma de pedidos</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://unpkg.com/lucide@latest"></script>

<style>
:root{
  --green:#2f7138;--green-dark:#1f5428;--green-light:#4b914f;--green-soft:#e9f4ea;
  --black:#111;--white:#fff;--gray-50:#f8f9f8;--gray-100:#f1f3f1;--gray-200:#e3e6e3;
  --gray-300:#d4d8d4;--gray-400:#8b918b;--gray-600:#5d635d;--danger:#b42318;
  --warning:#c98200;--shadow-sm:0 8px 25px rgba(0,0,0,.06);--shadow-md:0 20px 50px rgba(0,0,0,.1);
  --shadow-lg:0 35px 90px rgba(0,0,0,.16);--radius-md:20px;--radius-lg:28px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,sans-serif;color:var(--black);background:#fff;line-height:1.6;overflow-x:hidden}
body.locked{overflow:hidden}
button,input,select,textarea{font:inherit}
button{border:0}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
.container{width:min(calc(100% - 40px),1200px);margin:auto}
.section{padding:100px 0}
.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border-radius:100px;background:var(--green-soft);color:var(--green);font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}
.dot{width:7px;height:7px;border-radius:50%;background:var(--green)}
h1,h2,h3,h4{letter-spacing:-.04em}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 18px;border-radius:13px;border:1px solid transparent;font-weight:700;cursor:pointer;transition:.35s}
.btn:hover{transform:translateY(-2px)}
.btn-primary{background:var(--green);color:#fff;box-shadow:0 12px 25px rgba(47,113,56,.2)}
.btn-primary:hover{background:var(--green-dark)}
.btn-secondary{background:#fff;border-color:var(--gray-200)}
.btn-danger{background:#fff;border-color:#efc2be;color:var(--danger)}
.btn-soft{background:var(--green-soft);color:var(--green)}
.navbar{position:fixed;top:0;left:0;width:100%;z-index:1000;padding:18px 0;transition:.4s}
.navbar.scrolled{padding:11px 0;background:rgba(255,255,255,.88);backdrop-filter:blur(16px);box-shadow:0 8px 30px rgba(0,0,0,.06)}
.nav-wrap{display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{display:flex;align-items:center;gap:10px;font-size:1.2rem;font-weight:800}
.logo-mark{width:38px;height:38px;border-radius:12px;background:var(--green);color:#fff;display:grid;place-items:center}
.logo span{color:var(--green)}
.nav-links{display:flex;gap:24px;list-style:none}
.nav-links a{font-size:.87rem;color:var(--gray-600);font-weight:600;transition:.25s}
.nav-links a:hover{color:var(--green)}
.nav-actions{display:flex;align-items:center;gap:9px}
.cart-btn,.account-btn,.menu-toggle{position:relative;width:46px;height:46px;border-radius:13px;background:var(--gray-100);cursor:pointer;display:grid;place-items:center}
.cart-count{position:absolute;right:-3px;top:-4px;min-width:20px;height:20px;padding:0 5px;border-radius:999px;background:var(--green);color:#fff;font-size:.65rem;font-weight:800;display:grid;place-items:center}
.account-btn{width:auto;padding:0 12px;display:flex;gap:8px}
.account-btn .account-name{max-width:105px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.78rem;font-weight:700}
.menu-toggle{display:none}
.hero{min-height:78vh;padding:150px 0 70px;background:radial-gradient(circle at 80% 20%,rgba(47,113,56,.12),transparent 35%),radial-gradient(circle at 15% 75%,rgba(47,113,56,.07),transparent 30%),#fff}
.hero-grid{display:grid;grid-template-columns:1fr .85fr;gap:60px;align-items:center}
.hero h1{font-size:clamp(3.1rem,7vw,6.2rem);line-height:.94;margin:20px 0}
.hero h1 span{color:var(--green)}
.hero p{max-width:620px;color:var(--gray-600);font-size:1.08rem;margin-bottom:28px}
.hero-card{border-radius:28px;overflow:hidden;box-shadow:var(--shadow-lg);background:#fff}
.hero-card img{height:420px;width:100%;object-fit:cover}
.info-strip{padding:26px 0;border-bottom:1px solid var(--gray-200);border-top:1px solid var(--gray-200)}
.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.info-item{background:var(--green-soft);border-radius:18px;padding:18px;display:flex;gap:12px;align-items:flex-start}
.info-item i{color:var(--green)}.info-item strong{display:block;font-size:.9rem}.info-item span{color:var(--gray-600);font-size:.75rem}
.menu-section{background:var(--gray-50)}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:30px}
.section-head h2{font-size:clamp(2.2rem,5vw,4rem);line-height:1}
.section-head p{max-width:520px;color:var(--gray-600)}
.categories{display:flex;gap:10px;overflow:auto;padding-bottom:10px;margin-bottom:24px}
.category{border:1px solid var(--gray-200);background:#fff;color:var(--gray-600);padding:9px 14px;border-radius:999px;cursor:pointer;white-space:nowrap;font-weight:700;font-size:.82rem}
.category.active{background:var(--green);border-color:var(--green);color:#fff}
.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.product-card{background:#fff;border:1px solid var(--gray-200);border-radius:20px;overflow:hidden;transition:.4s}
.product-card:hover{transform:translateY(-7px);box-shadow:var(--shadow-md);border-color:rgba(47,113,56,.3)}
.product-image{height:220px;position:relative;overflow:hidden}
.product-image img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.product-card:hover img{transform:scale(1.05)}
.badge{position:absolute;left:14px;top:14px;background:#fff;color:var(--green);padding:6px 10px;border-radius:999px;font-size:.68rem;font-weight:800;box-shadow:var(--shadow-sm)}
.product-body{padding:18px}
.product-body h3{font-size:1.05rem;margin-bottom:6px}
.product-body p{font-size:.82rem;color:var(--gray-600);min-height:42px}
.product-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:15px}
.price{color:var(--green);font-weight:800;font-size:1rem}
.add-btn{border:0;background:var(--green);color:#fff;border-radius:12px;padding:10px 13px;cursor:pointer;font-weight:800;display:inline-flex;align-items:center;gap:6px}
.add-btn:hover{background:var(--green-dark)}
.section-muted{background:var(--gray-50)}
.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.feature-card{border:1px solid var(--gray-200);border-radius:20px;padding:28px;background:#fff;transition:.35s}
.feature-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-md)}
.feature-icon{width:48px;height:48px;display:grid;place-items:center;border-radius:14px;background:var(--green-soft);color:var(--green);margin-bottom:18px}
.feature-card p{color:var(--gray-600);font-size:.88rem}
.cta{margin:90px auto;width:min(calc(100% - 40px),1200px);padding:80px 30px;border-radius:30px;background:var(--green-dark);color:#fff;text-align:center;position:relative;overflow:hidden}
.cta:before{content:"";position:absolute;width:300px;height:300px;border-radius:50%;background:rgba(255,255,255,.05);left:-100px;top:-120px;filter:blur(8px)}
.cta h2{position:relative;font-size:clamp(2.5rem,6vw,5rem);line-height:.98;margin-bottom:15px}.cta p{position:relative;max-width:600px;margin:0 auto 25px;color:rgba(255,255,255,.7)}
footer{padding:60px 0 25px;border-top:1px solid var(--gray-200)}
.footer{display:flex;justify-content:space-between;gap:30px;align-items:center}.muted{color:var(--gray-600);font-size:.8rem}

.drawer-backdrop,.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.44);z-index:1090;opacity:0;visibility:hidden;transition:.3s}
.drawer-backdrop.open,.modal-backdrop.open{opacity:1;visibility:visible}
.drawer{position:fixed;right:0;top:0;height:100%;width:min(430px,100%);background:#fff;z-index:1100;transform:translateX(100%);transition:.45s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column}
.drawer.open{transform:translateX(0)}
.drawer-head{display:flex;align-items:center;justify-content:space-between;padding:22px;border-bottom:1px solid var(--gray-200)}
.close-btn{width:40px;height:40px;border-radius:11px;background:var(--gray-100);cursor:pointer}
.cart-items{padding:18px;overflow:auto;flex:1;display:grid;align-content:start;gap:12px}
.empty{padding:40px 10px;text-align:center;color:var(--gray-600)}
.cart-item{display:grid;grid-template-columns:72px 1fr auto;gap:12px;align-items:center;border:1px solid var(--gray-200);padding:10px;border-radius:16px}
.cart-item img{width:72px;height:72px;border-radius:12px;object-fit:cover}
.cart-item h4{font-size:.82rem;margin-bottom:4px}
.cart-item .unit{font-size:.72rem;color:var(--gray-400)}
.qty{display:flex;align-items:center;gap:6px;margin-top:8px}
.qty button{width:28px;height:28px;border:1px solid var(--gray-200);background:#fff;border-radius:8px;cursor:pointer;font-weight:800}
.qty span{min-width:20px;text-align:center;font-size:.8rem;font-weight:800}
.remove{border:0;background:transparent;color:var(--danger);font-size:.72rem;cursor:pointer;margin-top:6px}
.drawer-foot{padding:18px;border-top:1px solid var(--gray-200);display:grid;gap:12px}
.total-row{display:flex;justify-content:space-between;font-weight:800}.total-value{color:var(--green);font-size:1.1rem}
.checkout{width:100%}

.modal{position:fixed;left:50%;top:50%;transform:translate(-50%,-48%) scale(.97);width:min(520px,calc(100% - 28px));max-height:90vh;overflow:auto;background:#fff;border-radius:24px;z-index:1200;box-shadow:var(--shadow-lg);opacity:0;visibility:hidden;transition:.3s}
.modal.open{opacity:1;visibility:visible;transform:translate(-50%,-50%) scale(1)}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--gray-200)}
.modal-body{padding:24px}
.tabs{display:grid;grid-template-columns:1fr 1fr;background:var(--gray-100);padding:4px;border-radius:12px;margin-bottom:22px}
.tab{padding:10px;border-radius:9px;background:transparent;cursor:pointer;font-weight:700;color:var(--gray-600)}
.tab.active{background:#fff;color:var(--green);box-shadow:var(--shadow-sm)}
.form{display:grid;gap:14px}
.field{display:grid;gap:6px}.field label{font-size:.75rem;font-weight:700}.field input,.field select,.field textarea{width:100%;padding:12px 13px;border:1px solid var(--gray-200);border-radius:12px;outline:0;background:#fff}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--green);box-shadow:0 0 0 4px rgba(47,113,56,.08)}
.form-note{font-size:.75rem;color:var(--gray-400)}
.form-message{font-size:.8rem;display:none;padding:10px 12px;border-radius:10px}
.form-message.error{display:block;background:#fff1ef;color:var(--danger)}
.form-message.success{display:block;background:var(--green-soft);color:var(--green)}
.account-panel{position:relative;display:none}.account-panel.show{display:block}
.account-menu{display:grid;gap:10px}.account-menu button{padding:13px;border-radius:12px;background:var(--gray-50);text-align:left;cursor:pointer;font-weight:700}.account-menu button:hover{background:var(--green-soft);color:var(--green)}
.profile-summary{display:flex;align-items:center;gap:12px;padding:14px;background:var(--green-soft);border-radius:16px;margin-bottom:16px}.avatar{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--green);color:#fff;font-weight:800}

.admin-page{display:none;background:var(--gray-50);min-height:100vh;padding:120px 0 80px}
.admin-page.active{display:block}
.admin-top{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:28px}
.admin-top h1{font-size:clamp(2.2rem,5vw,4rem);line-height:1}
.admin-top p{color:var(--gray-600);margin-top:10px;max-width:680px}
.status-pill{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;font-size:.76rem;font-weight:800}
.status-open{background:var(--green-soft);color:var(--green)}.status-closed{background:#fff1ef;color:var(--danger)}
.admin-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:20px}
.admin-card{background:#fff;border:1px solid var(--gray-200);border-radius:20px;padding:24px}
.admin-card h3{margin-bottom:6px;font-size:1.2rem}.admin-card>p{color:var(--gray-600);font-size:.82rem;margin-bottom:20px}
.settings-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.hours{display:grid;gap:10px}
.hour-row{display:grid;grid-template-columns:110px 1fr auto 1fr;gap:10px;align-items:center}
.hour-row label{font-size:.8rem;font-weight:700}.hour-row input{padding:10px;border:1px solid var(--gray-200);border-radius:10px}.dash{color:var(--gray-400)}
.switch{position:relative;display:inline-flex;align-items:center;width:44px;height:26px}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:var(--gray-300);border-radius:20px;cursor:pointer;transition:.25s}.slider:before{content:"";position:absolute;width:20px;height:20px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.25s;box-shadow:0 2px 6px rgba(0,0,0,.12)}.switch input:checked+.slider{background:var(--green)}.switch input:checked+.slider:before{transform:translateX(18px)}
.local-preview{display:grid;gap:10px;margin-bottom:18px}.preview-row{display:flex;justify-content:space-between;gap:15px;padding:10px 0;border-bottom:1px solid var(--gray-200);font-size:.82rem}.preview-row span:first-child{color:var(--gray-400)}.preview-row strong{text-align:right}
.admin-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
.toast{position:fixed;left:50%;bottom:25px;transform:translate(-50%,20px);background:#111;color:#fff;padding:12px 16px;border-radius:12px;font-size:.8rem;z-index:1500;opacity:0;pointer-events:none;transition:.35s}.toast.show{opacity:1;transform:translate(-50%,0)}
.mobile-admin-link{display:none}

@media(max-width:1050px){.nav-links{gap:14px}.nav-links li:nth-child(n+4){display:none}}
@media(max-width:950px){.nav-links,.nav-actions .btn{display:none}.menu-toggle{display:grid}.nav-actions{margin-left:auto}.hero-grid{grid-template-columns:1fr}.hero-card{max-width:700px}.product-grid{grid-template-columns:repeat(2,1fr)}.feature-grid{grid-template-columns:1fr 1fr}.admin-grid{grid-template-columns:1fr}}
@media(max-width:650px){
  .container{width:min(calc(100% - 28px),1200px)}.section{padding:75px 0}.hero{padding-top:125px}.hero h1{font-size:clamp(3rem,14vw,4.4rem)}
  .product-grid,.feature-grid,.info-grid{grid-template-columns:1fr}.product-image{height:235px}.section-head{align-items:flex-start;flex-direction:column}
  .cta{width:calc(100% - 28px);padding:65px 22px}.footer{flex-direction:column;align-items:flex-start}
  .admin-top{flex-direction:column}.settings-grid{grid-template-columns:1fr}.hour-row{grid-template-columns:1fr 1fr auto 1fr}.hour-row label{grid-column:1/-1}.mobile-admin-link{display:block}
}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}

/* ============================================================
   FUNCIONES AVANZADAS FLASHFOOD
============================================================ */
.advanced-section{background:#fff}
.advanced-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.advanced-card{position:relative;background:#fff;border:1px solid var(--gray-200);border-radius:20px;padding:25px;transition:.35s;overflow:hidden}
.advanced-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-md);border-color:rgba(47,113,56,.3)}
.advanced-card .feature-icon{margin-bottom:16px}
.advanced-card h3{font-size:1.05rem;margin-bottom:7px}
.advanced-card p{font-size:.8rem;color:var(--gray-600)}
.flow-section{background:var(--gray-50)}
.flow-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;position:relative}
.flow-phase{background:#fff;border:1px solid var(--gray-200);border-radius:20px;padding:22px;min-height:310px;position:relative;overflow:hidden}
.flow-phase:after{content:"";position:absolute;right:-30px;bottom:-35px;width:120px;height:120px;border-radius:50%;background:var(--green-soft)}
.flow-number{width:42px;height:42px;border-radius:12px;background:var(--green);color:#fff;display:grid;place-items:center;font-size:.8rem;font-weight:800;margin-bottom:16px}
.flow-phase h3{font-size:1rem;margin-bottom:8px}
.flow-phase p{font-size:.78rem;color:var(--gray-600);margin-bottom:14px}
.flow-steps{list-style:none;display:grid;gap:8px;position:relative;z-index:2}
.flow-steps li{display:flex;align-items:flex-start;gap:8px;font-size:.74rem;font-weight:600}
.flow-steps li i{width:15px;height:15px;color:var(--green);flex:0 0 15px;margin-top:2px}
.flow-arrow{display:grid;place-items:center;color:var(--green);font-size:1.2rem}
.live-panel{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}
.live-card{background:#fff;border:1px solid var(--gray-200);border-radius:20px;padding:22px}
.live-status{display:inline-flex;align-items:center;gap:8px;padding:7px 10px;border-radius:999px;background:var(--green-soft);color:var(--green);font-size:.72rem;font-weight:800}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px rgba(47,113,56,.08)}
.timeline{display:grid;gap:10px;margin-top:15px}
.timeline-row{display:grid;grid-template-columns:90px 1fr auto;gap:10px;align-items:center;padding:10px 12px;border-radius:12px;background:var(--gray-50)}
.timeline-row strong{font-size:.75rem}.timeline-row span{font-size:.72rem;color:var(--gray-600)}.mini-badge{padding:4px 8px;border-radius:999px;font-size:.62rem;font-weight:800;background:var(--green-soft);color:var(--green)}
.admin-tools-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.admin-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:15px 0}
.admin-kpi{padding:14px;background:var(--gray-50);border-radius:14px}
.admin-kpi strong{display:block;font-size:1.05rem}.admin-kpi span{display:block;font-size:.68rem;color:var(--gray-400)}
.admin-table{width:100%;border-collapse:collapse;font-size:.72rem}.admin-table th,.admin-table td{padding:10px;border-bottom:1px solid var(--gray-200);text-align:left}.admin-table th{color:var(--gray-400);font-weight:700}
.stock-list,.promo-list,.role-list,.payment-list{display:grid;gap:10px}
.list-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px;background:var(--gray-50);border-radius:13px}
.list-row strong{font-size:.78rem}.list-row span{font-size:.7rem;color:var(--gray-600)}
.stock-badge{padding:5px 8px;border-radius:999px;font-size:.62rem;font-weight:800}.stock-ok{background:var(--green-soft);color:var(--green)}.stock-low{background:#fff6df;color:var(--warning)}.stock-out{background:#fff1ef;color:var(--danger)}
.admin-section-title{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:14px}
.admin-section-title h3{margin:0}
.admin-locked{opacity:.65}
@media(max-width:950px){.advanced-grid{grid-template-columns:1fr 1fr}.flow-grid{grid-template-columns:1fr 1fr}.live-panel,.admin-tools-grid{grid-template-columns:1fr}}
@media(max-width:650px){.advanced-grid,.flow-grid,.admin-tools-grid{grid-template-columns:1fr}.flow-phase{min-height:auto}.admin-kpis{grid-template-columns:1fr 1fr}.timeline-row{grid-template-columns:70px 1fr}.timeline-row .mini-badge{grid-column:2}}

</style>
</head>

<body>

<header class="navbar" id="navbar">
  <div class="container nav-wrap">
    <a class="logo" href="#inicio" id="brandLink">
      <div class="logo-mark"><i data-lucide="zap"></i></div>
      <div>Flash<span>FOOD</span></div>
    </a>

    <nav>
      <ul class="nav-links">
        <li><a href="#inicio">Inicio</a></li>
        <li><a href="#menu">Menú</a></li>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#beneficios">Beneficios</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </nav>

    <div class="nav-actions">
      <button class="cart-btn" id="cartOpen" aria-label="Abrir carrito">
        <i data-lucide="shopping-cart"></i>
        <span class="cart-count" id="cartCount">0</span>
      </button>

      <button class="account-btn" id="accountOpen" aria-label="Abrir cuenta">
        <i data-lucide="user-round"></i>
        <span class="account-name" id="accountName">Ingresar</span>
      </button>

      <a class="btn btn-primary" href="#menu">Ver menú</a>
      <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú móvil">
        <i data-lucide="menu"></i>
      </button>
    </div>
  </div>
</header>

<main id="publicApp">

<section class="hero" id="inicio">
  <div class="container hero-grid">
    <div>
      <span class="eyebrow"><span class="dot"></span> Velocidad que se saborea</span>
