    <button class="close-btn" id="mobileClose"><i data-lucide="x"></i></button>
  </div>
  <div class="modal-body">
    <div class="account-menu">
      <button data-mobile="inicio">Inicio</button>
      <button data-mobile="menu">Menú</button>
      <button data-mobile="como-funciona">Cómo funciona</button>
      <button data-mobile="beneficios">Beneficios</button>
      <button data-mobile="contacto">Contacto</button>
      <button id="mobileAccount">Mi cuenta</button>
    </div>
  </div>
</section>

<div class="toast" id="toast"></div>

<script>
/* ============================================================
   DATOS Y ESTADO
============================================================ */

const PRODUCTS = [
  {id:1,name:"Hamburguesa de queso Max S",category:"Comida",price:39999,img:"https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=900&q=80",desc:"Hamburguesa doble con carne, queso cheddar y vegetales frescos."},
  {id:2,name:"Ensalada con crotones y queso parmesano",category:"Comida",price:32999,img:"https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=900&q=80",desc:"Ensalada fresca con vegetales, queso y crotones."},
  {id:3,name:"Pollo crocante",category:"Comida",price:27999,img:"https://images.unsplash.com/photo-1604908176997-125f25cc6f3d?auto=format&fit=crop&w=900&q=80",desc:"Pollo crujiente acompañado de una porción fresca."},
  {id:4,name:"Papas especiales",category:"Meriendas",price:15999,img:"https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=900&q=80",desc:"Papas doradas con toppings y salsa especial."},
  {id:5,name:"Bebida fría",category:"Bebidas",price:7999,img:"https://images.unsplash.com/photo-1544145945-f90425340c7e?auto=format&fit=crop&w=900&q=80",desc:"Bebida refrescante para acompañar tu pedido."},
  {id:6,name:"Postre de la casa",category:"Meriendas",price:12999,img:"https://images.unsplash.com/photo-1565958011703-44f9829ba187?auto=format&fit=crop&w=900&q=80",desc:"Una opción dulce para cerrar el pedido."}
];

const DAYS = ["Lunes","Martes","Miércoles","Jueves","Viernes","Sábado","Domingo"];

const DEFAULT_HOURS = DAYS.map(day => ({
  day, active:true, open:"09:00", close:"21:00"
}));

const DEFAULT_BUSINESS = {
  name:"FlashFOOD",
  phone:"+57 300 000 0000",
  address:"Avenida Carrera 92 #52A-37",
  city:"Bogotá",
  email:"contacto@flashfood.co",
  description:"Plataforma digital para descubrir, ordenar y disfrutar alimentos."
};

const ADMIN_EMAIL = "admin@flashfood.co";
const ADMIN_PASSWORD = "FlashAdmin2026*";

const state = {
  cart:{},
  category:"Todos",
  currentUser:null,
  adminAuthenticated:false,
  businessOpen:true,
  hours: JSON.parse(localStorage.getItem("flashfood_hours") || "null") || DEFAULT_HOURS,
  business: JSON.parse(localStorage.getItem("flashfood_business") || "null") || DEFAULT_BUSINESS
};

const money = value => new Intl.NumberFormat("es-CO", {
  style:"currency", currency:"COP", maximumFractionDigits:0
}).format(value);

const categories = ["Todos", ...new Set(PRODUCTS.map(p=>p.category))];

function saveState(){
  localStorage.setItem("flashfood_hours", JSON.stringify(state.hours));
  localStorage.setItem("flashfood_business", JSON.stringify(state.business));
}

/* ============================================================
   UI PRINCIPAL
============================================================ */

function renderCategories(){
  const box = document.getElementById("categories");
  box.innerHTML = categories.map(c =>
    `<button class="category ${state.category===c?"active":""}" data-category="${c}">${c}</button>`
  ).join("");

  box.querySelectorAll(".category").forEach(btn=>{
    btn.addEventListener("click",()=>{
      state.category = btn.dataset.category;
      renderCategories();
      renderProducts();
    });
  });
}

function renderProducts(){
  const grid = document.getElementById("productGrid");
  const list = state.category==="Todos" ? PRODUCTS : PRODUCTS.filter(p=>p.category===state.category);

  grid.innerHTML = list.map(p => `
    <article class="product-card">
      <div class="product-image">
        <img src="${p.img}" alt="${p.name}" loading="lazy">
        <span class="badge">${p.category}</span>
      </div>
      <div class="product-body">
        <h3>${p.name}</h3>
        <p>${p.desc}</p>
        <div class="product-row">
          <span class="price">${money(p.price)}</span>
          <button class="add-btn" data-add="${p.id}">
            <i data-lucide="plus"></i> Agregar
          </button>
        </div>
      </div>
    </article>
  `).join("");

  grid.querySelectorAll("[data-add]").forEach(btn=>{
    btn.addEventListener("click",()=>addToCart(Number(btn.dataset.add)));
  });
  lucide.createIcons();
}

function addToCart(id){
  if(!state.businessOpen){
    showToast("El negocio está cerrado en este momento.");
    return;
  }
  state.cart[id] = (state.cart[id] || 0) + 1;
  renderCart();
  openCart();
}

function changeQty(id, delta){
  state.cart[id] = (state.cart[id] || 0) + delta;
  if(state.cart[id] <= 0) delete state.cart[id];
  renderCart();
}

function removeFromCart(id){
  delete state.cart[id];
  renderCart();
}

function renderCart(){
  const items = Object.entries(state.cart);
  const container = document.getElementById("cartItems");
  let total = 0, count = 0;

  if(!items.length){
    container.innerHTML = `<div class="empty"><i data-lucide="shopping-bag"></i><p>Tu carrito está vacío.</p><small>Agrega productos desde el menú.</small></div>`;
  }else{
    container.innerHTML = items.map(([id,qty])=>{
      const p = PRODUCTS.find(x=>x.id===Number(id));
      const subtotal = p.price * qty;
      total += subtotal;
      count += qty;

      return `
      <div class="cart-item">
        <img src="${p.img}" alt="${p.name}">
        <div>
          <h4>${p.name}</h4>
          <div class="unit">${money(p.price)} c/u</div>
          <div class="qty">
            <button data-minus="${p.id}" aria-label="Disminuir cantidad">−</button>
            <span>${qty}</span>
            <button data-plus="${p.id}" aria-label="Aumentar cantidad">+</button>
          </div>
          <button class="remove" data-remove="${p.id}">Eliminar</button>
        </div>
        <strong>${money(subtotal)}</strong>
      </div>`;
    }).join("");
  }

  document.getElementById("cartCount").textContent = count;
  document.getElementById("cartTotal").textContent = money(total);

  container.querySelectorAll("[data-minus]").forEach(b=>b.onclick=()=>changeQty(Number(b.dataset.minus),-1));
  container.querySelectorAll("[data-plus]").forEach(b=>b.onclick=()=>changeQty(Number(b.dataset.plus),1));
  container.querySelectorAll("[data-remove]").forEach(b=>b.onclick=()=>removeFromCart(Number(b.dataset.remove)));
  lucide.createIcons();
}

/* ============================================================
   CARRITO
============================================================ */

function openCart(){
  document.getElementById("drawer").classList.add("open");
  document.getElementById("backdrop").classList.add("open");
  document.body.classList.add("locked");
}
function closeCart(){
  document.getElementById("drawer").classList.remove("open");
  document.getElementById("backdrop").classList.remove("open");
  document.body.classList.remove("locked");
}
document.getElementById("cartOpen").onclick = openCart;
document.getElementById("cartClose").onclick = closeCart;
document.getElementById("backdrop").onclick = closeCart;

document.getElementById("checkout").onclick = () => {
  const count = Number(document.getElementById("cartCount").textContent);

  if(!count){
    showToast("Agrega al menos un producto al carrito.");
    return;
  }

  if(!state.currentUser){
    closeCart();
    openAuth("login");
    setFormMessage("loginMessage","Debes iniciar sesión antes de continuar al pago.","error");
    return;
  }

  showToast("Pedido preparado. Aquí puedes conectar tu pantalla real de pago.");
};

/* ============================================================
   AUTENTICACIÓN
============================================================ */

function getUsers(){
  return JSON.parse(localStorage.getItem("flashfood_users") || "[]");
}

function saveUsers(users){
  localStorage.setItem("flashfood_users", JSON.stringify(users));
}

function openAuth(tab="login"){
  document.getElementById("authModal").classList.add("open");
  document.getElementById("authBackdrop").classList.add("open");
  document.body.classList.add("locked");

  document.getElementById("authTabs").style.display = "grid";
  document.getElementById("authForms").style.display = "block";
  document.getElementById("accountPanel").classList.remove("show");

  switchAuthTab(tab);
}

function closeAuth(){
  document.getElementById("authModal").classList.remove("open");
  document.getElementById("authBackdrop").classList.remove("open");
  document.body.classList.remove("locked");
  clearMessages();
}

function switchAuthTab(tab){
  document.querySelectorAll("[data-auth-tab]").forEach(btn=>{
    btn.classList.toggle("active", btn.dataset.authTab===tab);
  });

  document.getElementById("loginForm").style.display = tab==="login" ? "grid" : "none";
  document.getElementById("registerForm").style.display = tab==="register" ? "grid" : "none";
  document.getElementById("authModalTitle").textContent = tab==="login" ? "Iniciar sesión" : "Crear cuenta";
}

function setFormMessage(id,text,type){
  const el = document.getElementById(id);
  el.textContent = text;
  el.className = "form-message " + type;
}
function clearMessages(){
  ["loginMessage","registerMessage"].forEach(id=>{
    const el=document.getElementById(id);
    el.textContent="";
    el.className="form-message";
  });
}

document.getElementById("accountOpen").onclick = () => {
  if(state.currentUser) openAccountPanel();
  else openAuth("login");
};

document.getElementById("heroAccount").onclick = () => openAuth("register");
document.getElementById("authClose").onclick = closeAuth;
document.getElementById("authBackdrop").onclick = closeAuth;

document.querySelectorAll("[data-auth-tab]").forEach(btn=>{
  btn.addEventListener("click",()=>switchAuthTab(btn.dataset.authTab));
});

document.getElementById("loginForm").addEventListener("submit",e=>{
  e.preventDefault();

  const email = document.getElementById("loginEmail").value.trim().toLowerCase();
  const password = document.getElementById("loginPassword").value;

  if(email === ADMIN_EMAIL && password === ADMIN_PASSWORD){
    state.currentUser = {name:"Super Administrador",email:ADMIN_EMAIL,role:"superadmin"};
    localStorage.setItem("flashfood_session", JSON.stringify(state.currentUser));
    updateAccountUI();
    closeAuth();
    openSuperAdmin();
    showToast("Sesión de Super Administrador iniciada.");
    return;
  }

  const user = getUsers().find(u => u.email.toLowerCase()===email && u.password===password);

  if(!user){
    setFormMessage("loginMessage","Correo o contraseña incorrectos.","error");
    return;
  }

  state.currentUser = user;
  localStorage.setItem("flashfood_session", JSON.stringify(user));
  updateAccountUI();
  closeAuth();
  showToast("Sesión iniciada correctamente.");
});

document.getElementById("registerForm").addEventListener("submit",e=>{
  e.preventDefault();

  const name=document.getElementById("registerName").value.trim();
  const last=document.getElementById("registerLast").value.trim();
  const email=document.getElementById("registerEmail").value.trim().toLowerCase();
  const phone=document.getElementById("registerPhone").value.trim();
  const password=document.getElementById("registerPassword").value;
  const confirm=document.getElementById("registerConfirm").value;

  if(password !== confirm){
    setFormMessage("registerMessage","Las contraseñas no coinciden.","error");
    return;
  }

  const users=getUsers();

  if(users.some(u=>u.email.toLowerCase()===email) || email===ADMIN_EMAIL){
    setFormMessage("registerMessage","Ya existe una cuenta con ese correo.","error");
    return;
  }

  const user={
    id:crypto.randomUUID ? crypto.randomUUID() : String(Date.now()),
    name:`${name} ${last}`,
    email,
    phone,
    password,
    role:"cliente"
  };

  users.push(user);
  saveUsers(users);

  state.currentUser=user;
  localStorage.setItem("flashfood_session",JSON.stringify(user));
  updateAccountUI();

  setFormMessage("registerMessage","Cuenta creada correctamente.","success");

  setTimeout(()=>{
    closeAuth();
    showToast("Bienvenido a FlashFOOD.");
  },700);
});

function openAccountPanel(){
  document.getElementById("authModal").classList.add("open");
  document.getElementById("authBackdrop").classList.add("open");
  document.body.classList.add("locked");
  document.getElementById("authTabs").style.display="none";
  document.getElementById("authForms").style.display="none";
  document.getElementById("accountPanel").classList.add("show");

  const name=state.currentUser.name || "Usuario";
  document.getElementById("profileName").textContent=name;
  document.getElementById("profileEmail").textContent=state.currentUser.email;
  document.getElementById("profileAvatar").textContent=name.charAt(0).toUpperCase();
}

document.getElementById("accountClosePanel").onclick=closeAuth;

document.getElementById("logoutBtn").onclick=()=>{
  state.currentUser=null;
  localStorage.removeItem("flashfood_session");
  updateAccountUI();
  closeAuth();
  closeSuperAdmin();
  showToast("Sesión cerrada.");
};

document.getElementById("adminAccess").onclick=()=>{
  if(state.currentUser?.role !== "superadmin"){
    closeAuth();
    openAuth("login");
    setFormMessage("loginMessage","El acceso de Super Administrador requiere credenciales administrativas.","error");
    return;
  }
  closeAuth();
  openSuperAdmin();
};

function updateAccountUI(){
  const btn=document.getElementById("accountOpen");
  const nameEl=document.getElementById("accountName");

  if(state.currentUser){
    nameEl.textContent=state.currentUser.role==="superadmin" ? "Super Admin" : state.currentUser.name.split(" ")[0];
    btn.setAttribute("aria-label","Abrir cuenta de "+state.currentUser.name);
  }else{
    nameEl.textContent="Ingresar";
    btn.setAttribute("aria-label","Iniciar sesión");
  }
}

function restoreSession(){
  const raw=localStorage.getItem("flashfood_session");
  if(raw){
    try{ state.currentUser=JSON.parse(raw); }catch{ state.currentUser=null; }
  }
  updateAccountUI();
}

/* ============================================================
   SUPER ADMINISTRADOR
============================================================ */

function renderHours(){
  const container=document.getElementById("hoursForm");

  container.innerHTML=state.hours.map((row,index)=>`
    <div class="hour-row" data-hour="${index}">
      <label>${row.day}</label>
      <label class="switch" title="Día activo">
        <input type="checkbox" class="day-active" ${row.active?"checked":""}>
        <span class="slider"></span>
      </label>
      <input type="time" class="hour-open" value="${row.open}" ${row.active?"":"disabled"}>
      <input type="time" class="hour-close" value="${row.close}" ${row.active?"":"disabled"}>
    </div>
  `).join("");

  container.querySelectorAll(".day-active").forEach(toggle=>{
    toggle.addEventListener("change",()=>{
      const row=toggle.closest(".hour-row");
      row.querySelector(".hour-open").disabled=!toggle.checked;
      row.querySelector(".hour-close").disabled=!toggle.checked;
    });
  });
}

document.getElementById("saveHours").onclick=()=>{
  const rows=[...document.querySelectorAll(".hour-row")];

  state.hours=rows.map((row,index)=>({
    day:DAYS[index],
    active:row.querySelector(".day-active").checked,
    open:row.querySelector(".hour-open").value,
    close:row.querySelector(".hour-close").value
  }));

  saveState();
  document.getElementById("controlSchedule").textContent="Actualizado";
  showToast("Horarios guardados correctamente.");
};

document.getElementById("businessForm").addEventListener("submit",e=>{
  e.preventDefault();

  state.business={
    name:document.getElementById("businessName").value.trim(),
    phone:document.getElementById("businessPhone").value.trim(),
    address:document.getElementById("businessAddress").value.trim(),
    city:document.getElementById("businessCity").value.trim(),
    email:document.getElementById("businessEmail").value.trim(),
    description:document.getElementById("businessDescription").value.trim()
  };

  saveState();
  renderBusinessPreview();
  showToast("Datos del local guardados.");
});

function renderBusinessPreview(){
  document.getElementById("businessName").value=state.business.name;
  document.getElementById("businessPhone").value=state.business.phone;
  document.getElementById("businessAddress").value=state.business.address;
  document.getElementById("businessCity").value=state.business.city;
  document.getElementById("businessEmail").value=state.business.email;
  document.getElementById("businessDescription").value=state.business.description;

  document.getElementById("previewName").textContent=state.business.name;
  document.getElementById("previewAddress").textContent=state.business.address;
  document.getElementById("previewCity").textContent=state.business.city;
  document.getElementById("previewPhone").textContent=state.business.phone;
  document.getElementById("previewEmail").textContent=state.business.email;
  document.getElementById("controlBusinessName").textContent=state.business.name;
}

document.getElementById("toggleBusiness").onclick=()=>{
  state.businessOpen=!state.businessOpen;
  updateBusinessStatus();
  showToast(state.businessOpen ? "Negocio marcado como abierto." : "Negocio marcado como cerrado.");
};

function updateBusinessStatus(){
  const el=document.getElementById("businessStatus");
  el.className="status-pill "+(state.businessOpen?"status-open":"status-closed");
  el.innerHTML=`<span class="dot"></span> ${state.businessOpen?"Negocio abierto":"Negocio cerrado"}`;
}

function openSuperAdmin(){
  if(!state.currentUser || state.currentUser.role!=="superadmin"){
    openAuth("login");
    setFormMessage("loginMessage","Acceso restringido al Super Administrador.","error");
    return;
  }

  document.getElementById("publicApp").style.display="none";
  document.getElementById("footerPublic").style.display="none";
  document.getElementById("superAdminPage").classList.add("active");
  window.scrollTo({top:0,behavior:"smooth"});
  renderHours();
  renderBusinessPreview();
  updateBusinessStatus();
  lucide.createIcons();
}

function closeSuperAdmin(){
  document.getElementById("superAdminPage").classList.remove("active");
  document.getElementById("publicApp").style.display="";
  document.getElementById("footerPublic").style.display="";
  window.scrollTo({top:0,behavior:"smooth"});
}

document.getElementById("returnPublic").onclick=closeSuperAdmin;
document.getElementById("brandLink").onclick=()=>{
  if(document.getElementById("superAdminPage").classList.contains("active")){
    closeSuperAdmin();
  }
};

/* ============================================================
   MOBILE MENU
============================================================ */

function openMobile(){
  document.getElementById("mobileModal").classList.add("open");
  document.getElementById("mobileBackdrop").classList.add("open");
  document.body.classList.add("locked");
}
function closeMobile(){
  document.getElementById("mobileModal").classList.remove("open");
  document.getElementById("mobileBackdrop").classList.remove("open");
  document.body.classList.remove("locked");
}
document.getElementById("menuToggle").onclick=openMobile;
document.getElementById("mobileClose").onclick=closeMobile;
document.getElementById("mobileBackdrop").onclick=closeMobile;

document.querySelectorAll("[data-mobile]").forEach(btn=>{
  btn.onclick=()=>{
    closeMobile();
    document.getElementById(btn.dataset.mobile)?.scrollIntoView({behavior:"smooth"});
  };
});
document.getElementById("mobileAccount").onclick=()=>{
  closeMobile();
  state.currentUser ? openAccountPanel() : openAuth("login");
};

/* ============================================================
   NAVBAR
============================================================ */

window.addEventListener("scroll",()=>{
  document.getElementById("navbar").classList.toggle("scrolled",window.scrollY>50);
},{passive:true});

/* ============================================================
   TOAST
============================================================ */

let toastTimer;
function showToast(message){
  const toast=document.getElementById("toast");
  toast.textContent=message;
  toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>toast.classList.remove("show"),2400);
}

/* ============================================================
   INICIO
============================================================ */

lucide.createIcons();
renderCategories();
renderProducts();
renderCart();
renderBusinessPreview();
updateBusinessStatus();
restoreSession();
/* ============================================================
   FUNCIONES ADMINISTRATIVAS DEMO
============================================================ */
document.getElementById("addDishBtn")?.addEventListener("click",()=>{
  showToast("Formulario de nuevo platillo preparado para integrar con la base de datos.");
});
document.getElementById("addPromoBtn")?.addEventListener("click",()=>{
  showToast("Módulo de promociones listo para conectar con reglas de descuento.");
});

</script>
</body>
</html>
